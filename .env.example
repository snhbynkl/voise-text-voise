# Server-side Gemini API key. Never commit a populated .env file.
GEMINI_API_KEY=

# Local Python voice-clone bridge.
VOICE_CLONE_PYTHON_EXE=
VOICE_CLONE_SCRIPT=scripts/run_clone_voice_module.py
VOICE_CLONE_WORKDIR=
VOICE_CLONE_MODULE=
VOICE_CLONE_CHUNK_SIZE=220
VOICE_CLONE_CHUNK_PAUSE_MS=180
VOICE_CLONE_SEED=0

DATA_DIR=data
PORT=3000
